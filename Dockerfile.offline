FROM python:3.11-slim
ENV PIP_DISABLE_PIP_VERSION_CHECK 1
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV LANG=ko_KR.UTF-8
ENV LANGUAGE=ko_KR:ko
ENV LC_ALL=ko_KR.UTF-8

# 필요한 시스템 패키지 설치 및 캐시 정리 + 한글 폰트 추가
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    python3-dev \
    curl \
    fontconfig \
    fonts-nanum \
    locales \
    && echo "ko_KR.UTF-8 UTF-8" > /etc/locale.gen \
    && locale-gen \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

WORKDIR /app

# 의존성 파일 복사 및 설치
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    find /usr/local -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true && \
    find /usr/local -name "*.pyc" -delete

# 애플리케이션 코드 복사
COPY . /app

# 볼륨 디렉터리 생성 (비어있는 디렉터리로 시작)
RUN mkdir -p /app/media /app/logs && \
    rm -rf /app/media/* && \
    rm -rf /app/logs/*
VOLUME ["/app/media", "/app/logs"]

# 포트 설정
EXPOSE 8000

# 실행 권한 설정
RUN chmod +x /app/docker-entrypoint.offline.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.offline.sh

# 실행 명령
CMD ["/app/docker-entrypoint.offline.sh"]